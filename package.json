{
  "name": "ml-learning-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node tests/numerical.mjs && node tests/structure.mjs && node tests/optimization.mjs && node tests/sequence.mjs && node tests/snapshots.mjs && node tests/compute.mjs && node tests/education.mjs && node tests/pipeline.mjs && node tests/sections.mjs && node tests/libraries.mjs && node tests/regression-tools.mjs && node tests/propagation.mjs && node tests/tree-arithmetic.mjs && node tests/classical-python.mjs && node tests/storage.mjs && node tests/classical-acceptance.mjs && node tests/math-acceptance.mjs && node tests/phase-directions.mjs && node tests/unsupervised-acceptance.mjs && node tests/deep-acceptance.mjs && node tests/data-acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "build:portable": "vite build --mode portable",
    "prebuild": "npm run libraries && node scripts/build-worker.mjs",
    "prebuild:portable": "npm run libraries && node scripts/build-worker.mjs",
    "predev": "npm run libraries && node scripts/build-worker.mjs",
    "portable": "npm run build:portable && python3 scripts/package-portable.py",
    "libraries": "node scripts/build-libraries.mjs && tailwindcss -i src/tailwind-input.css -o src/vendor/tailwind-utilities.css --minify"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "framer-motion": "^14.14.0",
    "katex": "^0.19.1",
    "ml-matrix": "^6.15.1",
    "plotly.js-cartesian-dist-min": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.20",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
